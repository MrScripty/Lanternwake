[node name="MicrophoneConsent" type="ConfirmationDialog"]
title = "Use your microphone?"
size = Vector2i(620, 230)
visible = false
dialog_autowrap = true
dialog_text = "Record up to 30 seconds. The limit stops capture without sending. Choose Stop and transcribe to send audio only to local Pumas. Return to story discards the recording. Review the transcript, then choose Say this yourself."
ok_button_text = "Start recording"
