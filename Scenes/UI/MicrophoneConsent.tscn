[node name="MicrophoneConsent" type="ConfirmationDialog"]
title = "Use your microphone?"
size = Vector2i(620, 230)
visible = false
dialog_text = "Record up to 30 seconds on this device and transcribe locally with Cohere Transcribe through Pumas Library. The recording is released after transcription. You can edit the transcript before choosing Say this. Nothing is sent automatically."
