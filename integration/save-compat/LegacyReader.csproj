<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireFrozenCore" BeforeTargets="BeforeBuild">
    <Error Condition="'$(FrozenCoreRoot)' == ''" Text="Set FrozenCoreRoot to the preserved reviewed checkout's Scripts/Core directory." />
  </Target>
  <ItemGroup><Compile Include="$(FrozenCoreRoot)/*.cs" Link="Core/%(Filename)%(Extension)" /></ItemGroup>
</Project>
